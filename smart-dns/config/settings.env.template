# -----------------------------------------------------------------------------
# settings.env  —  متغیرهای پیکربندی سرویس Smart DNS
# -----------------------------------------------------------------------------
# این فایل هنگام نصب توسط install.sh در مسیر /opt/smartdns/settings.env ساخته
# می‌شود و توسط پنل، اسکریپت سینک و سرویس‌های systemd خوانده می‌شود.
# پس از تغییر مقادیر، سرویس‌ها را ری‌استارت کنید:
#   systemctl restart smartdns-panel smartdns-sync.timer
# -----------------------------------------------------------------------------

# مسیر نصب پروژه
INSTALL_DIR=/opt/smartdns

# IP عمومی سرور (مقصدی که DNS برای دامنه‌های هدف برمی‌گرداند)
SERVER_IP=__SERVER_IP__

# DNS بالادستی (upstream) برای دامنه‌هایی که هدف نیستند
UPSTREAM_DNS=1.1.1.1

# --- پنل مدیریت وب ---
PANEL_HOST=0.0.0.0
PANEL_PORT=8088
# فقط این IP اجازه‌ی دسترسی به پنل را دارد (IP خانه/محل کار شما)
ADMIN_IP=__ADMIN_IP__

# کلید امنیتی سشن Flask (به‌صورت خودکار تولید می‌شود)
PANEL_SECRET=__PANEL_SECRET__

# مسیر دیتابیس SQLite
DB_PATH=/opt/smartdns/data/smartdns.db

# نام ست‌های ipset برای شمارش ترافیک ورودی/خروجی
IPSET_IN=smartdns_in
IPSET_OUT=smartdns_out

# پورت‌های سرویس که whitelist روی آن‌ها اعمال می‌شود
SERVICE_PORTS_TCP=53,80,443
SERVICE_PORTS_UDP=53
