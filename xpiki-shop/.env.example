# ---- Telegram ----
# Bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF...
# Numeric Telegram ids allowed to use the in-bot admin shortcuts (comma separated)
ADMIN_TELEGRAM_IDS=123456789
# Public HTTPS url where this app is reachable. Required for the Mini App button.
PUBLIC_URL=https://shop.example.com

# ---- Web server ----
PORT=3000
# Secret used to sign admin panel sessions. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# ---- Storage ----
DATABASE_FILE=./data/xpiki.db

# Everything else (wallet addresses, Alchemy key, TronGrid key, referral
# percent, required channel, ...) is configured from the web admin panel
# under Settings, so it can be changed without a restart.
