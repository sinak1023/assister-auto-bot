<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Hermes" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/hermes_bg</item>
        <item name="android:windowBackground">@color/hermes_bg</item>
    </style>

    <!-- Splash: shown during cold start via SplashScreen API -->
    <style name="Theme.Hermes.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/hermes_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_hermes_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Hermes</item>
        <item name="android:statusBarColor">@color/hermes_bg</item>
    </style>

</resources>
