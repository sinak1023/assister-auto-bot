# systemd unit for Hermes Web Terminal (tmux + ttyd).
# 1) Edit User= and the paths below to match your machine.
# 2) sudo cp hermes-web-term.service /etc/systemd/system/
# 3) sudo systemctl daemon-reload && sudo systemctl enable --now hermes-web-term
# Logs: journalctl -u hermes-web-term -f
#
# The hermes session lives in tmux, so it survives client disconnects. This
# service just keeps ttyd (the web front door) up and restarts it if it dies.

[Unit]
Description=Hermes Web Terminal
After=network.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/hermes_web_terminal
Environment=PORT=8787
Environment=PROFILE=conduit
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
# Make sure ~/.local/bin (where ttyd may be installed) is on PATH:
Environment=PATH=/home/YOUR_USER/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/YOUR_USER/hermes_web_terminal/hermes-web-term.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
