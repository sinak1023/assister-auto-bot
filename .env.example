# ─── CodeWeaver configuration ───────────────────────────────────────────────

# Required: your OpenRouter API key. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Port the web server listens on
PORT=8787

# Default model (id from OpenRouter). Can be switched live from the UI.
DEFAULT_MODEL=deepseek/deepseek-chat-v3-0324:free

# The directory the agent is allowed to read/write/run commands in.
# Everything is sandboxed to this folder. Defaults to ./workspace
WORKSPACE_DIR=./workspace

# Optional headers OpenRouter uses for attribution / rankings
OR_SITE_URL=http://localhost:8787
OR_SITE_NAME=CodeWeaver

# Set to "true" to allow the bash tool to run commands (off by default for safety)
ENABLE_BASH=true
