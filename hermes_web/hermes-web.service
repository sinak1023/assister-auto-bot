# systemd unit for running Hermes Web Chat persistently.
# 1) Edit User= and the path in ExecStart / WorkingDirectory to match your box.
# 2) sudo cp hermes-web.service /etc/systemd/system/
# 3) sudo systemctl daemon-reload && sudo systemctl enable --now hermes-web
# Logs: journalctl -u hermes-web -f

[Unit]
Description=Hermes Web Chat
After=network.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/hermes_web
ExecStart=/usr/bin/python3 /home/YOUR_USER/hermes_web/server.py
Restart=on-failure
RestartSec=3
# Optionally override the port here:
# Environment=PORT=8787

[Install]
WantedBy=multi-user.target
